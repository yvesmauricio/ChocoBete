# Configuração USADA SÓ PARA APLICAR AS MIGRAÇÕES DO BANCO (e para restaurar backup) pela linha de comando.
# Copie para "wrangler.migracoes.toml" e preencha. NÃO use o nome "wrangler.toml": num projeto Cloudflare Pages esse
# nome passa a mandar na configuração do site e pode sobrescrever o que você configurou no painel.
#
#   cp wrangler.migracoes.toml.exemplo wrangler.migracoes.toml
#   npx wrangler d1 migrations apply NOME_DO_BANCO --remote --config wrangler.migracoes.toml
#
# (wrangler.migracoes.toml fica fora do Git: ele só tem o ID do banco, que não é segredo, mas não precisa ser publicado.)
name = "chocobete-migracoes"
compatibility_date = "2025-01-01"

[[d1_databases]]
binding = "DB"
database_name = "NOME_DO_BANCO"                       # o nome que você deu ao criar o banco
database_id = "00000000-0000-0000-0000-000000000000"  # Cloudflare → Workers & Pages → D1 → seu banco → "Database ID"
migrations_dir = "migrations"
