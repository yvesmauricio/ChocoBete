+const CHAVE_PRECOS_VAR = 'cad_precos_variantes'
+
+/** Devolve { 'cat-trufa': [8, 9], … } em reais, ordenado e sem repetição. */
+export async function getPrecosVariantes() {
+  const row = await db.config.get(CHAVE_PRECOS_VAR).catch(() => null)
